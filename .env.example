# ── Supabase ──────────────────────────────────────────────────────────────
# Projeto `leadhunter` (dulpeemmwhudcjqwbolr)
NEXT_PUBLIC_SUPABASE_URL=https://dulpeemmwhudcjqwbolr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave privilegiada — Settings → API → service_role.
# NUNCA prefixe com NEXT_PUBLIC_: ela ignora RLS e só pode existir no servidor.
SUPABASE_SERVICE_ROLE_KEY=

# ── n8n ───────────────────────────────────────────────────────────────────
# Base dos webhooks (sem barra no final).
N8N_WEBHOOK_BASE=https://guizo.app.n8n.cloud/webhook

# Opcional: se os webhooks forem protegidos por Header Auth no n8n,
# preencha os dois campos abaixo com o mesmo par configurado lá.
N8N_WEBHOOK_HEADER_NOME=
N8N_WEBHOOK_HEADER_VALOR=

# ── Google Sheets (captura do LinkedIn pela extensão) ──────────────────────
# A extensão escreve direto na planilha "Prospecção - Vendas" — ver
# lib/planilha.ts — sem depender do n8n. Precisa de uma conta de serviço do
# Google Cloud com a planilha compartilhada para ela (permissão de Editor).
#
# Duas formas, escolha uma:
#   1. GOOGLE_CREDENTIALS_JSON — o JSON inteiro da chave da conta de serviço,
#      numa linha só.
#   2. GOOGLE_SERVICE_ACCOUNT_EMAIL + GOOGLE_PRIVATE_KEY — os dois campos
#      separados (a chave pode ter os \n literais, o código normaliza).
GOOGLE_CREDENTIALS_JSON=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# ID da planilha "Prospecção - Vendas" (o trecho entre /d/ e /edit na URL).
GOOGLE_SHEETS_ID=1Lp2Yy_j1SKducGIDXfWpviXxxpao-m_JHjSl3Z5_wYg

# Conta institucional que assina os envios de prospecção. Só alimenta o
# registro em `emails_enviados.conta_gmail_usada` — quem de fato envia é a
# credencial conectada no n8n.
GMAIL_REMETENTE=comercial@ufabcjr.com.br

# ── IA (enriquecimento sob demanda na tela de busca) ──────────────────────
ANTHROPIC_API_KEY=
